{
  "name": "pi-lcm",
  "version": "0.1.0",
  "description": "Lossless context and memory for Pi",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi-extension", "memory", "compaction"],
  "pi": { "extensions": ["./src/index.ts"] },
